# 네이버 개발자센터(developers.naver.com) > Application 등록 > "검색" API 사용 설정 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# npm run gen-vapid 실행 후 출력된 값 붙여넣기 (웹 푸시 인증용)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=your-email@example.com

# 검색할 상품명 (기본값: 서울우유 그릭요거트)
SEARCH_QUERY=서울우유 그릭요거트

PORT=3000

# 하루 3번 정기 요약 발송 시각 (cron 표현식, |로 여러개 구분 가능) - 기본: 오전9시/오후1시/오후8시
SUMMARY_CRON_TIMES=0 9,13,20 * * *

# 목표가 감시 주기 (기본: 30분마다)
THRESHOLD_CHECK_CRON=*/30 * * * *
